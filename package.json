{
  "name": "create-bun-mcp",
  "version": "1.1.1",
  "description": "Create a new MCP server project with Bun and TypeScript",
  "author": {
    "name": "krowten",
    "email": "me@krowten.dev",
    "url": "https://github.com/krowten"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krowten/create-bun-mcp.git"
  },
  "homepage": "https://github.com/krowten/create-bun-mcp#readme",
  "bugs": {
    "url": "https://github.com/krowten/create-bun-mcp/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "bun",
    "bun-mcp",
    "typescript",
    "boilerplate",
    "starter-kit",
    "mcp-sdk"
  ],
  "type": "module",
  "bin": {
    "create-bun-mcp": "./bin/index.ts"
  },
  "files": [
    "src",
    "bin",
    "README.md",
    "package.json",
    "tsconfig.json",
    "gitignore.template"
  ],
  "engines": {
    "bun": ">=1.0.0"
  },
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "dev:http": "bun run --watch src/http.ts",
    "start": "bun run src/index.ts",
    "start:http": "bun run src/http.ts",
    "inspect": "mcp-inspector --protocol-era modern -- bun run src/index.ts",
    "inspect:http": "mcp-inspector --protocol-era modern --transport http http://localhost:3000/mcp",
    "test": "bun test",
    "check": "tsc",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "bun run lint && bun run format:check && bun run check && bun test"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/inspector": "^2.12.0",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
